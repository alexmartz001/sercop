# ─────────────────────────────────────────────────────────────────────────────
# Radar de Oportunidades SERCOP — variables de entorno (copiar a .env o exportar)
# Todo lo marcado como opcional puede omitirse; el servidor arranca sin ellas.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────────────────
NVG_PORT=3210                      # puerto HTTP (opcional; si falta, se usa PORT)
NVG_HOST=127.0.0.1                 # 0.0.0.0 detrás del proxy (OpenShip lo fija)
NVG_DB=radar.db                    # ruta de la base SQLite (opcional)
NVG_BASE_URL=                      # URL pública, p.ej. https://radar.midominio.ec (para enlaces en notificaciones)

# ── Autenticación ─────────────────────────────────────────────────────────────
NVG_AUTH=on                        # "off" desactiva el login (SOLO desarrollo local)
NVG_AUTH_USER=admin                # usuario inicial (bootstrap)
NVG_AUTH_PASS=                     # contraseña inicial (mín. 10). Vacío o más corta: se define en /login, sin generar otra
NVG_SESSION_HOURS=12               # duración de la sesión (opcional)

# ── Correo (opcional): Microsoft Graph (recomendado) o SMTP ──────────────────
MAIL_PROVIDER=graph                # graph | smtp
MAIL_FROM=radar@midominio.ec       # remitente
MAIL_TO=equipo@midominio.ec        # destinatarios, separados por coma
# — Microsoft Graph (app registration con permiso Mail.Send, y Calendar si se usa) —
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=                      # UPN / email de la cuenta que envía (app-only)
GRAPH_SAVE_TO_SENT=false           # guardar copia en Sent Items
GRAPH_CALENDAR=false               # crear eventos de recordatorio en calendario
GRAPH_TIMEZONE=America/Guayaquil
GRAPH_REMINDER_MINUTES=60
# — SMTP (alternativa, vía nodemailer) —
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false

# ── Webhook saliente (opcional) — compatible Power Automate / Dynamics ───────
NVG_WEBHOOK_URL=                   # POST JSON firmado a este endpoint
NVG_WEBHOOK_SECRET=                # secreto HMAC (cabecera X-NVG-Signature)
NVG_WEBHOOK_BEARER=                # token Bearer opcional
NVG_WEBHOOK_EVENTS=alert,change,reminder
NVG_WEBHOOK_TIMEOUT_MS=10000

# ── Telegram (opcional) — Bot API ─────────────────────────────────────────────
# 1) Crea un bot con @BotFather y pega el token aquí.
# 2) Agrega el bot al grupo/canal y obtén el chat_id:
#    · Canal/grupo: invítalo y consulta getUpdates o usa @userinfobot.
#    · Canal privado: id numérico negativo que empieza por -100.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                  # uno o varios ids separados por coma (p.ej. -1001234567890,123456)
TELEGRAM_EVENTS=alert,change,reminder,test
TELEGRAM_DISABLE_PREVIEW=true      # no mostrar preview de enlaces
TELEGRAM_SILENT=false              # true = mensajes sin sonido (disable_notification)
TELEGRAM_TIMEOUT_MS=10000
# TELEGRAM_API_BASE=https://api.telegram.org   # solo para proxies/self-hosted (opcional)
